# Raw controller logs are ~15 MB per run. The provenance files, the derived
# metrics and the figures next to them ARE tracked, so every figure stays
# traceable to a commit and a parameter set without carrying the bulk data.
results/**/*.csv
pilot_results/**/*.csv
Old_Results/**/*.csv
# The metrics snapshot taken when the MAIN campaign was restarted is small
# and is the only record of the superseded rows, so it stays tracked.
!Old_Results/metrics_before_redo.csv

__pycache__/
*.pyc
